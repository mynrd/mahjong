/server/src/Mahjong.Api/wwwroot/

# ---------------------------------------------------------------- playwright
#
# Everything under e2e/ that a test run produces. The screenshots are worth looking at while
# working, which is why they are written to a fixed path rather than a temp folder, but every one
# of them is regenerated by `npx playwright test` so none of them belong in the history.

/e2e/test-results/
/e2e/playwright-report/
/e2e/blob-report/
/e2e/screenshots/
/e2e/.cache/
/e2e/playwright/.cache/

# ---------------------------------------------------------------- local config and secrets
#
# appsettings.json itself is committed: its connection string uses Windows authentication and
# holds no password. These are the files that would.

appsettings.*.local.json
appsettings.Local.json
*.local.json
.env
.env.*
!.env.example
secrets.json

# ---------------------------------------------------------------- database

*.mdf
*.ldf
*.ndf

# ---------------------------------------------------------------- local tooling
#
# Claude Code settings hold machine-specific paths and permission grants. Local only.

.claude/

# ---------------------------------------------------------------- editors
#
# Anchored to the root on purpose. An unanchored `.vscode/` would also swallow web/.vscode, and
# git cannot re-include a file whose parent directory is excluded - so the launch and tasks
# configs that web/.gitignore deliberately keeps would silently disappear.

/.vscode/
/.idea/
*.swp
*~

# ---------------------------------------------------------------- os

.DS_Store
Thumbs.db
desktop.ini
